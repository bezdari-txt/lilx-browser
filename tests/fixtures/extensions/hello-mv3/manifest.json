{
  "manifest_version": 3,
  "name": "Hello lilx",
  "version": "1.0.0",
  "description": "Test extension: marks pages and has a popup.",
  "action": { "default_popup": "popup.html", "default_title": "Hello lilx" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }],
  "icons": { "48": "icon48.png" }
}
